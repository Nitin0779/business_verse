# Environment Variables for BusinessVerse
# Copy this to .env and fill in your values

# ── Database Configuration ────────────────────────────────────────────────────
# Options: sqlite | mysql | postgresql
DB_TYPE=sqlite

# For MySQL or PostgreSQL only:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=businessverse
DB_USER=root
DB_PASSWORD=

# ── App Configuration ─────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
